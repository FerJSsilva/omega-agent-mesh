# Config do omega-agent-mesh. Copie para .env e ajuste se precisar.
# Todos os valores têm default — o mesh roda sem nenhum .env.

# Quando false, agents rodam com --no-session-persistence (efêmero).
MESH_SESSION_PERSISTENCE=true

# Quando true, grava .raw.log e .json por spawn em logs/.
MESH_LOG_TO_FILE=true

# Quando false, pula a sincronização de skills para os homes no boot.
MESH_SYNC_SKILLS=true

# Quantos agents podem rodar simultaneamente. Acima do limite, ficam na fila.
MESH_MAX_CONCURRENCY=3

# Porta do servidor GraphQL.
MESH_PORT=4000

# Arquivo do índice SQLite (workspace + jobs). Relativo à raiz do projeto.
MESH_DB_FILE=mesh-index.db

# Diretórios onde o mesh procura .claude/agents/*.md.
# Separador `;` (convenção Windows — paths podem conter `:` por causa de C:/).
# Paths relativos resolvem a partir da raiz do projeto.
MESH_HOMES=./homes/branding;./homes/conteudo;./homes/juridica
